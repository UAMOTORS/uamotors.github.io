---
import teamData from "../data/team.json";
import UserAvatar from "../icons/assets/userAvatar.astro";
---

<!--- contenedor general -->
<section class="flex flex-col items-center gap-12 p-4 mt-8">
  <div class="flex flex-col md:flex-row gap-8 justify-center w-full max-w-xl">
    <!-- Tarjeta Faculty Advisor -->
    <div
      class="bg-black/5 dark:bg-white/5 p-5 rounded-3xl border border-black/10 dark:border-white/10 hover:-translate-y-2 hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-300 flex flex-col items-center text-center w-full"
    >
      {
        teamData.facultyAdvisor.fotoPath.includes("user-avatar") ? (
          <UserAvatar class="w-20 h-20 mb-4 text-black dark:text-white opacity-20" />
        ) : (
          <img
            src={teamData.facultyAdvisor.fotoPath}
            alt="Faculty Advisor"
            class="w-20 h-20 rounded-full object-cover mb-4 border-4 border-space-red dark:border-space-yellow"
          />
        )
      }

      <p
        class="kanit-regular text-space-red dark:text-space-yellow uppercase tracking-widest text-sm mb-2"
      >
        {teamData.facultyAdvisor.puesto}
      </p>
      <h3 class="sigmar-ff text-lg mb-4 text-balance">
        {teamData.facultyAdvisor.nombre}
      </h3>
      <a
        href={teamData.facultyAdvisor.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="kanit-light text-lg underline hover:text-space-red dark:hover:text-space-yellow transition-colors"
        >LinkedIn</a
      >
    </div>

    <!-- Tarjeta Capitán -->
    <div
      class="bg-black/5 dark:bg-white/5 p-5 rounded-3xl border border-black/10 dark:border-white/10 hover:-translate-y-2 hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-300 flex flex-col items-center text-center w-full"
    >
      {
        teamData.capitan.fotoPath.includes("user-avatar") ? (
          <UserAvatar class="w-20 h-20 mb-4 text-black dark:text-white opacity-20" />
        ) : (
          <img
            src={teamData.capitan.fotoPath}
            alt="Capitán"
            class="w-20 h-20 rounded-full object-cover mb-4 border-4 border-space-red dark:border-space-yellow"
          />
        )
      }

      <p
        class="kanit-regular text-space-red dark:text-space-yellow uppercase tracking-widest text-sm mb-2"
      >
        {teamData.capitan.puesto}
      </p>
      <h3 class="sigmar-ff text-lg mb-4 text-balance">
        {teamData.capitan.nombre}
      </h3>
      <a
        href={teamData.capitan.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="kanit-light text-lg underline hover:text-space-red dark:hover:text-space-yellow transition-colors"
        >LinkedIn</a
      >
    </div>
  </div>

  <!-- Líderes de Departamento -->
  <div class="flex flex-col md:flex-row gap-6 w-full justify-center flex-wrap">
    {
      teamData.lideres.map((lider) => (
        <div class="bg-black/5 dark:bg-white/5 p-4 rounded-3xl border border-black/10 dark:border-white/10 hover:-translate-y-2 hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-300 flex flex-col items-center text-center w-full md:w-48">
          {lider.fotoPath.includes("user-avatar") ? (
            <UserAvatar class="w-20 h-20 mb-4 text-black dark:text-white opacity-20" />
          ) : (
            <img
              src={lider.fotoPath}
              alt={`Líder de ${lider.departamento}`}
              class="w-20 h-20 rounded-full object-cover mb-4 border-2 border-space-red dark:border-space-yellow"
            />
          )}

          <p class="kanit-regular text-space-red dark:text-space-yellow uppercase tracking-widest text-xs mb-2">
            Líder {lider.departamento}
          </p>
          <h3 class="sigmar-ff text-lg mb-3 leading-tight">{lider.nombre}</h3>

          <a
            href={lider.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="kanit-light text-base underline hover:text-space-red dark:hover:text-space-yellow transition-colors mb-6"
          >
            LinkedIn
          </a>

          <button
            onclick={`document.getElementById('modal-${lider.id}').showModal()`}
            class="mt-auto kanit-regular px-4 py-1.5 rounded-full border-2 border-space-red dark:border-space-yellow text-space-red dark:text-space-yellow hover:bg-space-red hover:text-white dark:hover:bg-space-yellow dark:hover:text-black transition-all duration-300"
          >
            Ver Equipo
          </button>

          <dialog
            id={`modal-${lider.id}`}
            class="p-8 rounded-3xl shadow-2xl bg-white dark:bg-neutral-900 text-black dark:text-white border border-black/10 dark:border-white/10 backdrop:bg-black/80 backdrop:backdrop-blur-md open:animate-fade-in w-11/12 max-w-md m-auto"
          >
            <h4 class="sigmar-ff text-2xl mb-6 text-center text-space-red dark:text-space-yellow">
              {lider.departamento}
            </h4>

            <ul class="text-left mb-8 space-y-3 kanit-light text-lg">
              {lider.integrantes.map((integrante) => (
                <li class="flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-space-red dark:bg-space-yellow shrink-0" />
                  {integrante}
                </li>
              ))}
            </ul>

            <form method="dialog" class="flex justify-center">
              <button class="kanit-regular px-8 py-2 rounded-full bg-black/10 dark:bg-white/10 hover:bg-black/20 dark:hover:bg-white/20 transition-all duration-300">
                Cerrar
              </button>
            </form>
          </dialog>
        </div>
      ))
    }
  </div>
</section>
