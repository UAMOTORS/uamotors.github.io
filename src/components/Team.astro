---
import teamData from "../data/team.json";
import UserAvatar from "../icons/assets/userAvatar.astro";
import LinkedinIcon from "../icons/social_media/Linkedin.astro";
---

<section class="flex flex-col items-center gap-8 p-4 mt-4">
  
  <!-- Top Cards (Advisor & Captain) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-4xl mx-auto justify-items-center auto-rows-fr">
    
    <!-- Tarjeta Faculty Advisor -->
    <div class="bg-black/5 dark:bg-white/5 p-5 md:p-6 rounded-3xl border border-black/10 dark:border-white/10 hover:-translate-y-2 hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-300 flex flex-col w-full h-full max-w-[400px]">
      <div class="flex items-center gap-4">
        {
          teamData.facultyAdvisor.fotoPath.includes("user-avatar") ? (
            <UserAvatar class="w-18 h-18 text-black dark:text-white opacity-20 shrink-0" />
          ) : (
            <img
              src={teamData.facultyAdvisor.fotoPath}
              alt="Faculty Advisor"
              class="w-18 h-18 rounded-full object-cover border-2 border-space-red dark:border-space-yellow shrink-0"
            />
          )
        }
        <p class="kanit-regular text-space-red dark:text-space-yellow uppercase tracking-widest text-sm text-left my-auto">
          {teamData.facultyAdvisor.puesto}
        </p>
      </div>

      <h4 class="sigmar-ff text-xl md:text-2xl leading-tight text-left mt-5 mb-5">
        {teamData.facultyAdvisor.nombre}
      </h4>
      
      <div class="mt-auto flex flex-row items-center justify-start gap-3">
        <a
          href={teamData.facultyAdvisor.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-4 py-2 rounded-full bg-black/10 dark:bg-white/10 hover:bg-black/20 dark:hover:bg-white/20 transition-all duration-300 kanit-regular text-sm md:text-base"
        >
          LinkedIn
        </a>
      </div>
    </div>

    <!-- Tarjeta Capitán -->
    <div class="bg-black/5 dark:bg-white/5 p-5 md:p-6 rounded-3xl border border-black/10 dark:border-white/10 hover:-translate-y-2 hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-300 flex flex-col w-full h-full max-w-[400px]">
      <div class="flex items-center gap-4">
        {
          teamData.capitan.fotoPath.includes("user-avatar") ? (
            <UserAvatar class="w-18 h-18 text-black dark:text-white opacity-20 shrink-0" />
          ) : (
            <img
              src={teamData.capitan.fotoPath}
              alt="Capitán"
              class="w-18 h-18 rounded-full object-cover border-2 border-space-red dark:border-space-yellow shrink-0"
            />
          )
        }
        <p class="kanit-regular text-space-red dark:text-space-yellow uppercase tracking-widest text-sm text-left my-auto">
          {teamData.capitan.puesto}
        </p>
      </div>

      <h4 class="sigmar-ff text-xl md:text-2xl leading-tight text-left mt-5 mb-5">
        {teamData.capitan.nombre}
      </h4>
      
      <div class="mt-auto flex flex-row items-center justify-start gap-3">
        <a
          href={teamData.capitan.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-4 py-2 rounded-full bg-black/10 dark:bg-white/10 hover:bg-black/20 dark:hover:bg-white/20 transition-all duration-300 kanit-regular text-sm md:text-base"
        >
          LinkedIn
        </a>
        <button
          onclick="toggleDepto('depto-capitan', this, 'Departamento', 'Cerrar')"
          class="kanit-regular px-4 py-1.5 rounded-full border-1 border-space-red dark:border-space-yellow text-space-red dark:text-space-yellow hover:bg-space-red hover:text-white dark:hover:bg-space-yellow dark:hover:text-black transition-all duration-300 text-sm md:text-base"
        >
          Departamento
        </button>
      </div>

      <!-- Acordeon integrantes capitan -->
      <div id="depto-capitan" class="w-full max-h-0 overflow-hidden opacity-0 transition-all duration-500 ease-in-out">
        <div class="mt-6 pt-6 border-t border-black/10 dark:border-white/10">
          <ul class="text-left space-y-3 kanit-light text-base md:text-lg w-full">
            {teamData.capitan.integrantes.map((integrante) => (
              <li class="flex items-start justify-between gap-3 w-full">
                <div class="flex items-start gap-3 mt-1.5">
                  <span class="w-2 h-2 mt-2 rounded-full bg-space-red dark:bg-space-yellow shrink-0" />
                  <span>{integrante.nombre}</span>
                </div>
                {integrante.linkedin && (
                  <a href={integrante.linkedin} target="_blank" rel="noopener noreferrer" class="p-2 text-black dark:text-white hover:text-space-red dark:hover:text-space-yellow transition-colors duration-300">
                    <LinkedinIcon class="w-5 h-5" />
                  </a>
                )}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <!-- Líderes de Departamento -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-4xl mx-auto justify-items-center auto-rows-fr">
    {
      teamData.lideres.map((lider) => (
        <div class="bg-black/5 dark:bg-white/5 p-5 md:p-6 rounded-3xl border border-black/10 dark:border-white/10 hover:-translate-y-2 hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-300 flex flex-col w-full h-full max-w-[400px]">
          
          <div class="flex items-center gap-4">
            {lider.fotoPath.includes("user-avatar") ? (
              <UserAvatar class="w-18 h-18 text-black dark:text-white opacity-20 shrink-0" />
            ) : (
              <img
                src={lider.fotoPath}
                alt={`Líder de ${lider.departamento}`}
                class="w-18 h-18 rounded-full object-cover border-2 border-space-red dark:border-space-yellow shrink-0"
              />
            )}
            <p class="kanit-regular text-space-red dark:text-space-yellow uppercase tracking-widest text-sm text-left my-auto">
              Líder<br />{lider.departamento}
            </p>
          </div>

          <h4 class="sigmar-ff text-xl md:text-2xl leading-tight text-left mt-5 mb-5">
            {lider.nombre}
          </h4>

          <div class="mt-auto flex flex-row items-center justify-start gap-3">
            <a
              href={lider.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block px-4 py-2 rounded-full bg-black/10 dark:bg-white/10 hover:bg-black/20 dark:hover:bg-white/20 transition-all duration-300 kanit-regular text-sm md:text-base"
            >
              LinkedIn
            </a>

            <button
              onclick={`toggleDepto('depto-${lider.id}', this, 'Departamento', 'Cerrar')`}
              class="kanit-regular px-4 py-1.5 rounded-full border-1 border-space-red dark:border-space-yellow text-space-red dark:text-space-yellow hover:bg-space-red hover:text-white dark:hover:bg-space-yellow dark:hover:text-black transition-all duration-300 text-sm md:text-base"
            >
              Departamento
            </button>
          </div>

          <!-- Acordeon integrantes -->
          <div id={`depto-${lider.id}`} class="w-full max-h-0 overflow-hidden opacity-0 transition-all duration-500 ease-in-out">
            <div class="mt-6 pt-6 border-t border-black/10 dark:border-white/10">
              <ul class="text-left space-y-3 kanit-light text-base md:text-lg w-full">
                {lider.integrantes.map((integrante) => (
                  <li class="flex items-start justify-between gap-3 w-full">
                    <div class="flex items-start gap-3 mt-1.5">
                      <span class="w-2 h-2 mt-2 rounded-full bg-space-red dark:bg-space-yellow shrink-0" />
                      <span>{integrante.nombre ? integrante.nombre : integrante}</span>
                    </div>
                    {integrante.linkedin && (
                      <a href={integrante.linkedin} target="_blank" rel="noopener noreferrer" class="p-2 text-black dark:text-white hover:text-space-red dark:hover:text-space-yellow transition-colors duration-300">
                        <LinkedinIcon class="w-5 h-5" />
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </div>

        </div>
      ))
    }
  </div>
</section>

<script is:inline>
  function toggleDepto(id, btn, textOpen, textClose) {
    const el = document.getElementById(id);
    const isClosed = el.classList.contains('max-h-0');
    
    if (isClosed) {
      el.classList.remove('max-h-0', 'opacity-0');
      el.classList.add('max-h-[1000px]', 'opacity-100');
      btn.innerText = textClose;
    } else {
      el.classList.add('max-h-0', 'opacity-0');
      el.classList.remove('max-h-[1000px]', 'opacity-100');
      btn.innerText = textOpen;
    }
  }
</script>
