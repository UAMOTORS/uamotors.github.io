---
import MainLayout from "../../layouts/MainLayout.astro";
import siteConfig from "../../site.config";
import { withBase } from "../../utils/helpers";
import Button from "../Button.astro";
import { Image } from "astro:assets";
import heroImage from "../../assets/images/pixeltrue-space-discovery.svg";
import ArrowRight from "../../icons/ArrowRight.astro";
// import OP_image_vertical from "../../assets/images/OP-26_2-transparent.png";
// import OP_image_mobile from "../../assets/images/OP-26_2-transparent-cut.png";
import OP_image_vertical from "../../assets/images/OP-26_hero.png";
// import OP_image_mobile from "../../assets/images/OP-26_hero-mobile.png";

// i18n
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<script is:inline>
  if (
    window.location.pathname === "/" ||
    window.location.pathname === "/index.html"
  ) {
    const alreadyRedirected = sessionStorage.getItem("lang_redirect");
    if (!alreadyRedirected) {
      const userLang = navigator.language || navigator.userLanguage;
      const lang = userLang.toLowerCase();
      const isSpanish = lang.startsWith("es");
      const isMexico = lang.includes("-mx") || lang.endsWith("mx");

      if (!isSpanish && !isMexico) {
        sessionStorage.setItem("lang_redirect", "true");
        window.location.replace("/en/");
      }
    }
  }
</script>

<MainLayout
  activePage="home"
  pageTitle={siteConfig.title + " | Escudería Formula SAE UAM"}
>
  <div
    class="jumbo-banner relative flex flex-row items-stretch justify-between w-full pl-4 pr-0 md:px-4 my-8 md:my-12 gap-2 md:gap-6 [overflow-x:clip] [overflow-y:visible] md:overflow-visible"
  >
    {/* <svg 
      class="absolute -top-24 -left-24 sm:-top-36 sm:-left-4 w-[450px] h-[450px] sm:w-[600px] sm:h-[600px] -z-10 pointer-events-none"
      viewBox="0 0 100 100" 
      xmlns="http://www.w3.org/2000/svg"
      pointer-events="none"
    >
      <defs>
        <radialGradient id="glow-text-light" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#E31E24" stop-opacity="0.25" />
          <stop offset="100%" stop-color="#E31E24" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="glow-text-dark" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#FF4046" stop-opacity="0.10" />
          <stop offset="100%" stop-color="#FF4046" stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle cx="50" cy="50" r="50" class="fill-[url(#glow-text-light)] dark:fill-[url(#glow-text-dark)]" />
    </svg> */}

    <div class="w-[54%] sm:w-[50%] md:flex-1 shrink-0 min-w-0 relative z-30 pr-2 md:pr-0 flex flex-col justify-center">
      {
        siteConfig.hero?.eyebrowText && (
          <span
            id="hero-eyebrow-text"
            class="tag inline-block w-fit self-start mb-2 rounded-full text-sm sm:text-base px-3 py-1 border border-gray-500 kanit-light select-none cursor-pointer"
            style="touch-action: manipulation;"
          >
            {siteConfig.hero?.eyebrowText}
          </span>
        )
      }

      {/* hero title */}
      <h1 class="sigmar-ff-italic leading-tight text-balance md:pt-0!">
        {t("home.hero.title")}
      </h1>

      {/* hero text */}

      <p
        class="kanit-regular text-balance text-base md:text-lg"
        set:html={t("home.hero.text")}
      />
      <div
        class="flex flex-col sm:flex-row items-stretch sm:items-center text-xs md:text-base gap-2 sm:gap-3 mt-3 md:mt-12"
      >
        {/* {
          siteConfig.hero?.actions?.map((action, index) => (
            <Button
              href={action.href}
              class={
                index === 0
                  ? "space-btn-filled !py-2.5"
                  : "space-btn-outlined !py-2"
              }
            >
              {t("home.hero.btn1")}
            </Button>
          ))
        } */}
        <Button
          href={lang === "en" ? "en/proyecto" : "/proyecto"}
          class="space-btn-filled !py-2.5"
          >{t("home.hero.btn1")}
        </Button>

        <Button
          href={lang === "en" ? "/en/nuestros-aliados" : "/nuestros-aliados"}
          class="space-btn-outlined !py-2"
          >{t("home.hero.btn2")}
        </Button>
      </div>
    </div>
    <div
      class="flex-1 min-w-0 relative flex justify-start md:justify-center items-center [overflow-x:clip] [overflow-y:visible] md:overflow-visible group"
    >
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#808080_1px,transparent_1px),linear-gradient(to_bottom,#808080_1px,transparent_1px)] bg-[size:40px_40px] opacity-15 dark:opacity-25 pointer-events-none rounded-2xl [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_70%)]"
      >
      </div>

      <div
        class="relative h-full w-full flex justify-start md:justify-center items-center transition-transform duration-700 py-2"
      >
        <div
          class="relative z-10 animate-car-levitate h-full max-h-[460px] md:max-h-[500px] aspect-[1400/2795] flex items-center justify-start md:justify-center shrink-0 origin-left md:origin-center"
        >
          {/* Telemetry laser scan: bottom reverse beam */}
          <div class="laser-beam-container pointer-events-none z-0">
            <div class="laser-beam-line laser-reverse">
              <div class="laser-trail-reverse"></div>
              <div class="laser-core"></div>
            </div>
          </div>

          {/* Carro Completo (Desktop y Movil) */}
          <Image
            class="w-full h-full max-w-none object-contain object-left md:object-center select-none pointer-events-none"
            src={OP_image_vertical}
            alt="UAMOTORS Vehicle"
            transition:name="hero-image"
          />

          {/* Telemetry laser scan: top forward beam */}
          <div class="laser-beam-container pointer-events-none z-20">
            <div class="laser-beam-line laser-forward">
              <div class="laser-trail-forward"></div>
              <div class="laser-core"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="page-content">
    <div
      id="instagram-feed"
      class="flex flex-col items-center justify-center w-full"
    >
      <h2
        class="sigmar-ff text-balance pt-0! pb-8! text-space-red dark:text-space-yellow"
      >
        {t("home.instragram")}
      </h2>

      <div class="w-full max-w-4xl mx-auto mt-4 overflow-hidden">
        <div id="curator-feed-default-feed-layout">
          <a href="https://curator.io" target="_blank" class="crt-logo crt-tag"
            >Powered by Curator.io</a
          >
        </div>

        <script type="text/javascript" is:inline data-astro-rerun>
          (function () {
            var i,
              e,
              d = document,
              s = "script";
            i = d.createElement("script");
            i.async = 1;
            i.charset = "UTF-8";
            i.src =
              "https://cdn.curator.io/published/a1e46c5e-ad11-49f1-b60c-867fd268c002.js";
            e = d.getElementsByTagName(s)[0];
            e.parentNode.insertBefore(i, e);
          })();
        </script>
      </div>

      <Button
        href="https://www.instagram.com/uamotors.fsae"
        target="_blank"
        class="space-btn-filled mt-8"
      >
        @uamotors.fsae <ArrowRight class="w-5 h-5 fill-current ml-4" />
      </Button>
    </div>
  </div>
</MainLayout>

