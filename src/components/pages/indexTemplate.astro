  /* Optical telemetry laser scan styles */
  .laser-beam-container {
    position: absolute;
    inset: -0.5rem 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
  }

  .laser-beam-line {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    will-change: top, bottom, opacity, transform;
  }

  .laser-core {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    background: linear-gradient(to right, transparent 5%, rgba(255, 255, 255, 0.95) 50%, transparent 95%);
    box-shadow:
      0 0 14px 3px rgba(227, 30, 36, 0.9),
      0 0 3px 1px rgba(255, 255, 255, 0.9);
  }

  .laser-trail-forward {
    position: absolute;
    bottom: 2px;
    left: 0;
    width: 100%;
    height: 32px;
    background: linear-gradient(to top, rgba(227, 30, 36, 0.16), transparent);
    pointer-events: none;
  }

  .laser-trail-reverse {
    position: absolute;
    top: 2px;
    left: 0;
    width: 100%;
    height: 32px;
    background: linear-gradient(to bottom, rgba(227, 30, 36, 0.16), transparent);
    pointer-events: none;
  }

  @keyframes laser-scan-forward-v5 {
    0% {
      top: 0%;
      opacity: 0;
      transform: scaleX(0);
    }
    3% {
      top: 0%;
      opacity: 1;
