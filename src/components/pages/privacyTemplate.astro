---
import MainLayout from "../../layouts/MainLayout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<MainLayout activePage="" pageTitle={t("privacy.")}>
  <main class="max-w-4xl mx-auto px-6 py-16 min-h-screen">
    <h1
      class="sigmar-ff text-3xl sm:text-5xl mb-8 text-space-red dark:text-space-yellow"
    >
      {t("privacy.heading")}
    </h1>

    <div
      class="kanit-regular space-y-6 text-gray-800 dark:text-gray-300 text-lg"
    >
      <p set:html={t("privacy.intro")} />

      <h2 class="text-2xl font-bold mt-8 text-black dark:text-white">
        {t("privacy.h2.1")}
      </h2>
      <p set:html={t("privacy.p.1")} />

      <h2 class="text-2xl font-bold mt-8 text-black dark:text-white">
        {t("privacy.h2.2")}
      </h2>
      <p set:html={t("privacy.p.2")} />

      <h2 class="text-2xl font-bold mt-8 text-black dark:text-white">
        {t("privacy.h2.3")}
      </h2>
      <p set:html={t("privacy.p.3")} />
    </div>
  </main>
</MainLayout>
