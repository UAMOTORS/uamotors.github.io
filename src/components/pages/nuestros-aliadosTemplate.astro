---
import { Image } from "astro:assets";
import MainLayout from "../../layouts/MainLayout.astro";
import siteConfig from "../../site.config";
import EmailIcon from "../../icons/social_media/Email.astro";
import Eyes from "../../icons/general/Eyes.astro";
import Mobile from "../../icons/general/Mobile.astro";
import Document from "../../icons/general/Document.astro";
import Event from "../../icons/general/Event.astro";
import LogoFuam from "../../components/logos/bronze/LogoFuam.astro";
import LogoSolidworks from "../../components/logos/gold/LogoSolidworks.astro";
import LogoAnsys from "../../components/logos/gold/LogoAnsys.astro";
import LogoEsss from "../../components/logos/gold/LogoEsss.astro";
import LogoHarnessDesign from "../../components/logos/gold/LogoHarnessDesign.astro";
import LogoRapidHarnest from "../../components/logos/gold/LogoRapidHarnest.astro";
import LogoDitsa from "../../components/logos/silver/LogoDitsa.astro";
import LogoPrimeraPlus from "../../components/logos/silver/LogoPrimeraPlus.astro";
import LogoDepartamentoEnergia from "../../components/logos/bronze/LogoDepartamentoEnergia.astro";
import LogoEscuadronUam from "../../components/logos/bronze/LogoEscuadronUam.astro";
import LogoDewesoft from "../../components/logos/silver/LogoDewesoft.astro";
import LogoRealisSimulation from "../../components/logos/gold/LogoRealisSimulation.astro";

import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<MainLayout
  activePage="nuestros aliados"
  pageTitle={siteConfig.title + " | " + t("aliados.meta.title")}
  description={t("aliados.meta.desc")}
>
  <div class="page-content max-w-5xl mx-auto min-w-0">
    <h1 class="sigmar-ff text-balance mb-8">{t("aliados.main.title")}</h1>

    <section id="nuestros-aliados" class="text-left space-y-16">
      <div class="space-y-12 md:space-y-20">
        {/* Gold */}
        <div
          id="oro-grid"
          class="grid grid-cols-2 md:grid-cols-3 gap-8 md:gap-12 w-full max-w-4xl mx-auto place-items-center"
        >
          {/* 1. Ansys */}
          <div class="w-full flex items-center justify-center h-16 sm:h-20">
            <a
              href="https://www.ansys.com/"
              target="_blank"
              class="h-full w-full flex items-center justify-center md:md:hover:scale-105 transition-transform duration-300"
            >
              <LogoAnsys
                class="h-auto w-20 sm:w-24 md:w-28 max-w-full object-contain"
              />
            </a>
          </div>
          {/* 2. ESSS */}
          <div class="w-full flex items-center justify-center h-16 sm:h-20">
            <a
              href="https://www.esss.com/es/"
              target="_blank"
              class="h-full w-full flex items-center justify-center md:md:hover:scale-105 transition-transform duration-300"
            >
              <LogoEsss class="max-h-[75%] max-w-full object-contain" />
            </a>
          </div>
          {/* 3. Realis Simulation */}
          <div class="w-full flex items-center justify-center h-16 sm:h-20">
            <a
              href="https://www.realis-simulation.com/"
              target="_blank"
              class="h-full w-full flex items-center justify-center md:md:hover:scale-105 transition-transform duration-300"
            >
              <LogoRealisSimulation
                class="h-auto w-24 sm:w-28 md:w-32 max-w-full object-contain"
              />
            </a>
          </div>
          {/* 4. Solidworks */}
          <div class="w-full flex items-center justify-center h-16 sm:h-20">
            <a
              href="https://www.solidworks.com/"
              target="_blank"
              class="h-full w-full flex items-center justify-center md:md:hover:scale-105 transition-transform duration-300"
            >
              <LogoSolidworks
                class="h-auto w-36 sm:w-44 md:w-52 max-w-full object-contain"
              />
            </a>
          </div>
          {/* 5. Harness Design */}
          <div class="w-full flex items-center justify-center h-16 sm:h-20">
            <a
              id="harness-link"
              href="https://www.harness.design/"
              target="_blank"
              class="h-full w-full flex items-center justify-center md:md:hover:scale-105 transition-transform duration-300"
            >
              <LogoHarnessDesign
                class="h-auto w-40 sm:w-48 md:w-56 max-w-full object-contain"
              />
            </a>
          </div>
          {/* 6. Rapid Harness */}
          <div class="w-full flex items-center justify-center h-16 sm:h-20">
            <a
              href="https://www.rapidharness.com/"
              target="_blank"
              class="h-full w-full flex items-center justify-center md:md:hover:scale-105 transition-transform duration-300"
            >
              <LogoRapidHarnest
                class="h-auto w-32 sm:w-40 md:w-48 max-w-full object-contain"
              />
            </a>
          </div>
        </div>

        {/* Silver */}
        <div id="plata-grid" class="w-full">
          <div
            class="flex flex-row justify-center gap-6 sm:gap-16 md:gap-24 lg:gap-32 items-center max-w-4xl mx-auto"
          >
            <div
              class="h-11 md:h-12 w-32 sm:w-32 md:w-36 flex items-center justify-center"
            >
              <a
                id="dewesoft-link"
                href="https://dewesoft.com/es"
                target="_blank"
                class="h-full w-full flex items-center justify-center relative z-20"
              >
                <LogoDewesoft class="max-h-full max-w-full object-contain" />
              </a>
            </div>
            <div
              class="h-11 md:h-12 w-32 sm:w-32 md:w-36 flex items-center justify-center"
            >
              <a
                href="https://ditsa.com.mx/"
                target="_blank"
                class="h-full w-full flex items-center justify-center"
              >
                <LogoDitsa class="max-h-full max-w-full object-contain" />
              </a>
            </div>
            <div
              class="h-11 md:h-12 w-32 sm:w-32 md:w-36 flex items-center justify-center"
            >
              <a
                href="https://www.primeraplus.com.mx/"
                target="_blank"
                class="h-full w-full flex items-center justify-center"
              >
                <LogoPrimeraPlus class="max-h-full max-w-full object-contain" />
              </a>
            </div>
          </div>
        </div>

        {/* Bronze */}
        <div id="bronce-grid" class="w-full">
          <div
            class="flex flex-row flex-nowrap items-center justify-center gap-6 sm:gap-16 md:gap-24 lg:gap-32 max-w-4xl mx-auto"
          >
            <div
              class="h-8 md:h-8 w-20 sm:w-22 md:w-26 flex items-center justify-center"
            >
              <a
                href="https://www.fundacionuam.org/"
                target="_blank"
                class="h-full w-full flex items-center justify-center"
              >
                <LogoFuam class="max-h-full max-w-full object-contain" />
              </a>
            </div>
            <div
              class="h-10 md:h-11 w-10 sm:w-12 md:w-15 flex items-center justify-center"
            >
              <a
                href="http://fenix.uam.mx/escuadron_uam/"
                target="_blank"
                class="h-full w-full flex items-center justify-center"
              >
                <LogoEscuadronUam
                  class="max-h-full max-w-full object-contain"
                />
              </a>
            </div>
            <div
              class="h-8 md:h-8 w-20 sm:w-22 md:w-26 flex items-center justify-center"
            >
              <a
                href="https://energia.azc.uam.mx/en/"
                target="_blank"
                class="h-full w-full flex items-center justify-center"
              >
                <LogoDepartamentoEnergia
                  class="max-h-full max-w-full object-contain"
                />
              </a>
            </div>
          </div>
        </div>
      </div>
      <div>
        <p
          class="kanit-light text-lg sm:text-xl leading-relaxed mb-8 text-center sm:text-left"
          set:html={t("aliados.intro.text")}
        />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div
            class="bg-black/5 dark:bg-white/5 p-8 rounded-3xl border border-black/10 dark:border-white/10 md:hover:-translate-y-2 md:hover:bg-black/10 dark:md:hover:bg-white/10 transition-all duration-300"
          >
            <h4
              class="sigmar-ff text-xl mb-3 text-space-red dark:text-space-yellow"
            >
              {t("aliados.card1.title")}
            </h4>
            <p class="kanit-light text-base sm:text-lg leading-relaxed">
              {t("aliados.card1.text")}
            </p>
          </div>
          <div
            class="bg-black/5 dark:bg-white/5 p-8 rounded-3xl border border-black/10 dark:border-white/10 md:hover:-translate-y-2 md:hover:bg-black/10 dark:md:hover:bg-white/10 transition-all duration-300"
          >
            <h4
              class="sigmar-ff text-xl mb-3 text-space-red dark:text-space-yellow"
            >
              {t("aliados.card2.title")}
            </h4>
            <p
              class="kanit-light text-base sm:text-lg leading-relaxed"
              set:html={t("aliados.card2.text")}
            />
          </div>
        </div>
      </div>

      <div>
        <h2
          class="sigmar-ff text-3xl mb-8 text-space-red dark:text-space-yellow"
        >
          {t("aliados.beneficios.title")}
        </h2>
        <ul
          class="grid grid-cols-1 md:grid-cols-2 gap-8 gap-y-12 kanit-light text-lg sm:text-xl"
        >
          <li class="flex items-start gap-4">
            <Eyes class="w-8 h-8 shrink-0 mt-1" />
            <div>
              <strong
                class="kanit-regular text-space-red dark:text-space-yellow"
                >{t("aliados.beneficio1.title")}</strong
              ><br />
              <span set:html={t("aliados.beneficio1.text")} />
              <sup> **</sup>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <Mobile class="w-8 h-8 shrink-0 mt-1" />
            <div>
              <strong
                class="kanit-regular text-space-red dark:text-space-yellow"
                >{t("aliados.beneficio2.title")}</strong
              ><br />
              <span set:html={t("aliados.beneficio2.text")} />
              <sup> **</sup>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <Document class="w-8 h-8 shrink-0 mt-1" />
            <div>
              <strong
                class="kanit-regular text-space-red dark:text-space-yellow"
                >{t("aliados.beneficio3.title")}</strong
              ><br />
              <span set:html={t("aliados.beneficio3.text")} />
              <sup> *</sup>
            </div>
          </li>
          <li class="flex items-start gap-4">
            <Event class="w-8 h-8 shrink-0 mt-1" />
            <div>
              <strong
                class="kanit-regular text-space-red dark:text-space-yellow"
                >{t("aliados.beneficio4.title")}</strong
              ><br />
              <span set:html={t("aliados.beneficio4.text")} />
              <sup> **</sup>
            </div>
          </li>
        </ul>
      </div>

      <div
        id="unete"
        class="bg-space-red/10 dark:bg-space-yellow/10 p-8 sm:p-12 rounded-3xl text-center border border-space-red/20 dark:border-space-yellow/20"
      >
        <h2
          class="sigmar-ff text-3xl sm:text-4xl mb-4 text-space-red dark:text-space-yellow"
        >
          {t("aliados.cta.title")}
        </h2>
        <p
          class="kanit-light text-lg sm:text-xl leading-relaxed mb-8 max-w-2xl mx-auto opacity-90"
          set:html={t("aliados.cta.text")}
        />
        <div
          class="mt-8 pt-8 border-t border-space-red/20 dark:border-white/10 flex flex-col sm:flex-row justify-center gap-6 sm:gap-12 kanit-light text-lg"
        >
          <a
            href="mailto:uamotors.fsae@azc.uam.mx?subject=Interés%20en%20Propuesta%20de%20Patrocinio"
            class="flex items-center justify-center gap-2 hover:text-space-red dark:hover:text-space-yellow transition-colors group"
          >
            <EmailIcon class="w-5 h-5" /> uamotors.fsae@azc.uam.mx
          </a>
        </div>
      </div>

      <ul class="flex flex-col gap-1 text-base text-left list-none m-0 p-0">
        <li class="flex items-start gap-2 !m-0 !p-0 leading-tight">
          <div class="w-4 shrink-0 text-right">
            <sup class="leading-none">*</sup>
          </div>
          <div>{t("aliados.notice1")}</div>
        </li>
        <li class="flex items-start gap-2 !m-0 !p-0 leading-tight">
          <div class="w-4 shrink-0 text-right">
            <sup class="leading-none">**</sup>
          </div>
          <div>{t("aliados.notice2")}</div>
        </li>
      </ul>
    </section>
  </div>

  <style is:global>
    #oro-grid img,
    #plata-grid img,
    #bronce-grid img {
      border-radius: 0 !important;
    }
    #oro-grid svg,
    #oro-grid img,
    #plata-grid svg,
    #plata-grid img,
    #bronce-grid svg,
    #bronce-grid img {
      transition: all 0.15s ease-in-out !important;
    }

    html.light {
      --logo-filter: grayscale(1) opacity(1)
        drop-shadow(0 0 1px rgba(255, 255, 255, 1))
        drop-shadow(0 6px 8px rgba(100, 85, 75, 1));
      --logo-hover-filter: grayscale(0) opacity(1);
      --realis-shadow: drop-shadow(0 0 6px rgba(255, 255, 255, 1))
        drop-shadow(0 8px 10px rgba(100, 85, 75, 1));
      --realis-hover-shadow: drop-shadow(0 0 2px rgba(255, 255, 255, 1))
        drop-shadow(0 8px 10px rgba(100, 85, 75, 1));
    }

    html.dark {
      --logo-filter: grayscale(1) invert(1) opacity(0.85)
        drop-shadow(0 0 2px rgba(0, 0, 0, 1))
        drop-shadow(0 8px 10px rgba(0, 0, 0, 1));
      --logo-hover-filter: grayscale(0) invert(0) opacity(1);
      --realis-shadow: drop-shadow(0 0 6px rgba(0, 0, 0, 1))
        drop-shadow(0 8px 10px rgba(0, 0, 0, 1));
      --realis-hover-shadow: drop-shadow(0 0 8px rgba(0, 0, 0, 0.9));
    }

    #oro-grid svg:not(.realis-logo),
    #oro-grid img,
    #plata-grid svg,
    #plata-grid img,
    #bronce-grid svg,
    #bronce-grid img {
      opacity: 1 !important;
      filter: var(--logo-filter) !important;
    }

    /* El logo de Realis ahora usa color directo (Tailwind classes) en lugar de filtros */
    #oro-grid svg.realis-logo {
      transition: all 0.3s ease;
      filter: var(--realis-shadow) !important;
    }

    @media (hover: hover) {
      #oro-grid a:hover svg:not(.realis-logo),
      #oro-grid a:hover img,
      #plata-grid a:hover svg,
      #plata-grid a:hover img,
      #bronce-grid a:hover svg,
      #bronce-grid a:hover img {
        opacity: 1 !important;
        filter: var(--logo-hover-filter) !important;
      }

      /* Al hacer hover en la tarjeta (el a), cambiamos el color del SVG hijo */
      #oro-grid a:hover svg.realis-logo {
        transform: scale(1.05);
        color: #00c4c4; /* Cian más cercano al original pero visible en fondo claro */
        filter: var(--realis-hover-shadow) !important;
      }

      html.dark #oro-grid a:hover svg.realis-logo {
        color: #00ffff; /* Cian neón original para modo oscuro */
      }
    }
  </style>

  <script src="../../scripts/aliados-animations.js"></script>
</MainLayout>
