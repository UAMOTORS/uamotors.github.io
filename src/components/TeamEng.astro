---
import teamData from "../data/team.json";
import UserAvatar from "../icons/assets/userAvatar.astro";
---

<section class="flex flex-col items-center gap-8 p-4 mt-4">
  
  <!-- Top Cards (Advisor & Captain) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-4xl mx-auto justify-items-center auto-rows-fr">
    
    <!-- Tarjeta Faculty Advisor -->
    <div class="bg-black/5 dark:bg-white/5 p-6 rounded-3xl border border-black/10 dark:border-white/10 hover:-translate-y-2 hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-300 flex flex-col w-full h-full max-w-[400px]">
      <div class="flex items-center gap-4">
        {
          teamData.facultyAdvisor.fotoPath.includes("user-avatar") ? (
            <UserAvatar class="w-18 h-18 text-black dark:text-white opacity-20 shrink-0" />
          ) : (
            <img
              src={teamData.facultyAdvisor.fotoPath}
              alt="Faculty Advisor"
              class="w-18 h-18 rounded-full object-cover border-2 border-space-red dark:border-space-yellow shrink-0"
            />
          )
        }
        <p class="kanit-regular text-space-red dark:text-space-yellow uppercase tracking-widest text-sm text-left my-auto">
          {teamData.facultyAdvisor.puesto}
        </p>
      </div>

      <h4 class="sigmar-ff text-xl md:text-2xl leading-tight text-left mt-5 mb-5">
        {teamData.facultyAdvisor.nombre}
      </h4>
      
      <div class="mt-auto flex flex-row items-center justify-start gap-3">
        <a
          href={teamData.facultyAdvisor.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-4 py-2 rounded-full bg-black/10 dark:bg-white/10 hover:bg-black/20 dark:hover:bg-white/20 transition-all duration-300 kanit-regular text-sm md:text-base"
        >
          LinkedIn
        </a>
      </div>
    </div>

    <!-- Tarjeta Capitán -->
    <div class="bg-black/5 dark:bg-white/5 p-6 rounded-3xl border border-black/10 dark:border-white/10 hover:-translate-y-2 hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-300 flex flex-col w-full h-full max-w-[400px]">
      <div class="flex items-center gap-4">
        {
          teamData.capitan.fotoPath.includes("user-avatar") ? (
            <UserAvatar class="w-18 h-18 text-black dark:text-white opacity-20 shrink-0" />
          ) : (
            <img
              src={teamData.capitan.fotoPath}
              alt="Capitán"
              class="w-18 h-18 rounded-full object-cover border-2 border-space-red dark:border-space-yellow shrink-0"
            />
          )
        }
        <p class="kanit-regular text-space-red dark:text-space-yellow uppercase tracking-widest text-sm text-left my-auto">
          {teamData.capitan.puesto}
        </p>
      </div>

      <h4 class="sigmar-ff text-xl md:text-2xl leading-tight text-left mt-5 mb-5">
        {teamData.capitan.nombre}
      </h4>
      
      <div class="mt-auto flex flex-row items-center justify-start gap-3">
        <a
          href={teamData.capitan.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block px-4 py-2 rounded-full bg-black/10 dark:bg-white/10 hover:bg-black/20 dark:hover:bg-white/20 transition-all duration-300 kanit-regular text-sm md:text-base"
        >
          LinkedIn
        </a>
        <button
          onclick="document.getElementById('modal-capitan-en').showModal()"
          class="kanit-regular px-4 py-1.5 rounded-full border-1 border-space-red dark:border-space-yellow text-space-red dark:text-space-yellow hover:bg-space-red hover:text-white dark:hover:bg-space-yellow dark:hover:text-black transition-all duration-300 text-sm md:text-base"
        >
          Department
        </button>
      </div>

      <!-- dialogo integrantes capitan -->
      <dialog
        id="modal-capitan-en"
        class="p-8 rounded-3xl shadow-2xl bg-white dark:bg-neutral-900 text-black dark:text-white border border-black/10 dark:border-white/10 backdrop:bg-black/80 backdrop:backdrop-blur-md open:animate-fade-in w-11/12 max-w-md m-auto"
      >
        <h4 class="sigmar-ff text-3xl mb-6 text-center text-space-red dark:text-space-yellow">
          {teamData.capitan.puesto}
        </h4>
        <p class="kanit-regular text-center mb-6">Department information coming soon...</p>
        <form method="dialog" class="flex justify-center">
          <button class="kanit-regular px-8 py-2 rounded-full bg-black/10 dark:bg-white/10 hover:bg-black/20 dark:hover:bg-white/20 transition-all duration-300">
            Close
          </button>
        </form>
      </dialog>
    </div>
  </div>

  <!-- Líderes de Departamento -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-4xl mx-auto justify-items-center auto-rows-fr">
    {
      teamData.lideres.map((lider) => (
        <div class="bg-black/5 dark:bg-white/5 p-6 rounded-3xl border border-black/10 dark:border-white/10 hover:-translate-y-2 hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-300 flex flex-col w-full h-full max-w-[400px]">
          
          <div class="flex items-center gap-4">
            {lider.fotoPath.includes("user-avatar") ? (
              <UserAvatar class="w-18 h-18 text-black dark:text-white opacity-20 shrink-0" />
            ) : (
              <img
                src={lider.fotoPath}
                alt={`Líder de ${lider.departamento}`}
                class="w-18 h-18 rounded-full object-cover border-2 border-space-red dark:border-space-yellow shrink-0"
              />
            )}
            <p class="kanit-regular text-space-red dark:text-space-yellow uppercase tracking-widest text-sm text-left my-auto">
              Lead<br />{lider.departamento}
            </p>
          </div>

          <h4 class="sigmar-ff text-xl md:text-2xl leading-tight text-left mt-5 mb-5">
            {lider.nombre}
          </h4>

          <div class="mt-auto flex flex-row items-center justify-start gap-3">
            <a
              href={lider.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block px-4 py-2 rounded-full bg-black/10 dark:bg-white/10 hover:bg-black/20 dark:hover:bg-white/20 transition-all duration-300 kanit-regular text-sm md:text-base"
            >
              LinkedIn
            </a>

            <button
              onclick={`document.getElementById('modal-${lider.id}-en').showModal()`}
              class="kanit-regular px-4 py-1.5 rounded-full border-1 border-space-red dark:border-space-yellow text-space-red dark:text-space-yellow hover:bg-space-red hover:text-white dark:hover:bg-space-yellow dark:hover:text-black transition-all duration-300 text-sm md:text-base"
            >
              Department
            </button>
          </div>

          <!-- dialogo integrantes -->
          <dialog
            id={`modal-${lider.id}-en`}
            class="p-8 rounded-3xl shadow-2xl bg-white dark:bg-neutral-900 text-black dark:text-white border border-black/10 dark:border-white/10 backdrop:bg-black/80 backdrop:backdrop-blur-md open:animate-fade-in w-11/12 max-w-md m-auto"
          >
            <h4 class="sigmar-ff text-3xl mb-6 text-center text-space-red dark:text-space-yellow">
              {lider.departamento}
            </h4>

            <ul class="text-left mb-8 space-y-3 kanit-light text-lg">
              {lider.integrantes.map((integrante) => (
                <li class="flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-space-red dark:bg-space-yellow shrink-0" />
                  {integrante}
                </li>
              ))}
            </ul>

            <form method="dialog" class="flex justify-center">
              <button class="kanit-regular px-8 py-2 rounded-full bg-black/10 dark:bg-white/10 hover:bg-black/20 dark:hover:bg-white/20 transition-all duration-300">
                Close
              </button>
            </form>
          </dialog>
        </div>
      ))
    }
  </div>
</section>
