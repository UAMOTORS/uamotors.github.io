---
import teamData from "../data/team.json";
import UserAvatar from "../icons/assets/userAvatar.astro";
import LinkedinIcon from "../icons/social_media/Linkedin.astro";
---

<section class="flex flex-col items-center gap-8 mt-4 w-full px-2 md:px-0">
  
  <!-- Top Cards (Advisor & Captain) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-5xl mx-auto items-start">
    
    <!-- Tarjeta Faculty Advisor -->
    <div class="bg-black/5 dark:bg-white/5 p-4 md:p-6 rounded-3xl border border-black/10 dark:border-white/10 hover:-translate-y-2 hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-300 flex flex-col w-full max-w-[500px] mx-auto">
      <p class="kanit-regular text-space-red dark:text-space-yellow uppercase tracking-widest text-sm text-center mb-4 -translate-y-1">
        {teamData.facultyAdvisor.puesto}
      </p>
      
      <div class="flex items-center gap-4 mb-6">
        {
          teamData.facultyAdvisor.fotoPath.includes("user-avatar") ? (
            <UserAvatar class="w-32 h-32 text-black dark:text-white opacity-20 shrink-0" />
          ) : (
            <img
              src={teamData.facultyAdvisor.fotoPath}
              alt="Faculty Advisor"
              class="w-32 h-32 !rounded-full aspect-square object-cover border border-space-red dark:border-space-yellow shrink-0" style="border-radius: 50%;"
            />
          )
        }
        <h4 class="sigmar-ff text-xl md:text-2xl leading-tight text-left">
          {teamData.facultyAdvisor.nombre}
        </h4>
      </div>
      
      <div class="mt-auto flex flex-row items-center justify-start gap-3">
        <a
          href={teamData.facultyAdvisor.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-black/10 dark:bg-white/10 hover:bg-black/20 dark:hover:bg-white/20 transition-all duration-300 kanit-regular text-sm md:text-base border border-transparent"
        >
          <LinkedinIcon class="w-5 h-5" />
          LinkedIn
        </a>
      </div>
    </div>

    <!-- Tarjeta Capitán -->
    <div class="bg-black/5 dark:bg-white/5 p-4 md:p-6 rounded-3xl border border-black/10 dark:border-white/10 hover:-translate-y-2 hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-300 flex flex-col w-full max-w-[500px] mx-auto">
      <p class="kanit-regular text-space-red dark:text-space-yellow uppercase tracking-widest text-sm text-center mb-4 -translate-y-1">
        {teamData.capitan.puesto}
      </p>
      
      <div class="flex items-center gap-4 mb-6">
        {
          teamData.capitan.fotoPath.includes("user-avatar") ? (
            <UserAvatar class="w-32 h-32 text-black dark:text-white opacity-20 shrink-0" />
          ) : (
            <img
              src={teamData.capitan.fotoPath}
              alt="Captain"
              class="w-32 h-32 !rounded-full aspect-square object-cover border border-space-red dark:border-space-yellow shrink-0" style="border-radius: 50%;"
            />
          )
        }
        <h4 class="sigmar-ff text-xl md:text-2xl leading-tight text-left">
          {teamData.capitan.nombre}
        </h4>
      </div>
      
      <div class="mt-auto flex flex-row items-center justify-start gap-3">
        <a
          href={teamData.capitan.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-black/10 dark:bg-white/10 hover:bg-black/20 dark:hover:bg-white/20 transition-all duration-300 kanit-regular text-sm md:text-base border border-transparent"
        >
          <LinkedinIcon class="w-5 h-5" />
          LinkedIn
        </a>
        <button
          onclick="toggleDeptoEng('depto-capitan-en', this, 'Department', 'Close')"
          class="kanit-regular px-4 py-1.5 rounded-full border border-space-red dark:border-space-yellow text-space-red dark:text-space-yellow hover:bg-space-red hover:text-white dark:hover:bg-space-yellow dark:hover:text-black transition-all duration-300 text-sm md:text-base"
        >
          Departament
        </button>
      </div>

      <!-- Acordeon integrantes capitan -->
      <div id="depto-capitan-en" class="grid transition-all duration-500 ease-in-out" style="grid-template-rows: 0fr; opacity: 0;">
        <div class="overflow-hidden">
          <div class="mt-6 pt-6 border-t border-black/10 dark:border-white/10">
            <ul class="text-left space-y-4 kanit-light text-base md:text-lg w-full">
              {teamData.capitan.integrantes.map((integrante) => (
                <li class="flex items-center justify-between gap-3 w-full">
                  <div class="flex items-start gap-3">
                    <span class="w-2 h-2 mt-2.5 rounded-full bg-space-red dark:bg-space-yellow shrink-0" />
                    <span>{integrante.nombre}</span>
                  </div>
                  {integrante.linkedin && (
                    <a href={integrante.linkedin} target="_blank" rel="noopener noreferrer" class="p-2 -my-2 text-black dark:text-white hover:text-space-red dark:hover:text-space-yellow transition-colors duration-300 shrink-0">
                      <LinkedinIcon class="w-6 h-6" />
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Líderes de Departamento -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full max-w-5xl mx-auto items-start">
    {
      teamData.lideres.map((lider) => (
        <div class="bg-black/5 dark:bg-white/5 p-4 md:p-6 rounded-3xl border border-black/10 dark:border-white/10 hover:-translate-y-2 hover:bg-black/10 dark:hover:bg-white/10 transition-all duration-300 flex flex-col w-full max-w-[500px] mx-auto">


          <p class="kanit-regular text-space-red dark:text-space-yellow uppercase tracking-widest text-sm text-center mb-4 -translate-y-1">
            Lead {lider.departamento}
          </p>
          
          <div class="flex items-center gap-4 mb-6">
            {lider.fotoPath.includes("user-avatar") ? (
              <UserAvatar class="w-32 h-32 text-black dark:text-white opacity-20 shrink-0" />
            ) : (
              <img
                src={lider.fotoPath}
                alt={`Líder de ${lider.departamento}`}
                class="w-32 h-32 !rounded-full aspect-square object-cover border border-space-red dark:border-space-yellow shrink-0" style="border-radius: 50%;"
              />
            )}
            <h4 class="sigmar-ff text-xl md:text-2xl leading-tight text-left">
              {lider.nombre}
            </h4>
          </div>

          <div class="mt-auto flex flex-row items-center justify-start gap-3">
            <a
              href={lider.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-black/10 dark:bg-white/10 hover:bg-black/20 dark:hover:bg-white/20 transition-all duration-300 kanit-regular text-sm md:text-base border border-transparent"
            >
              <LinkedinIcon class="w-5 h-5" />
              LinkedIn
            </a>

            <button
              onclick={`toggleDeptoEng('depto-${lider.id}-en', this, 'Department', 'Close')`}
              class="kanit-regular px-4 py-1.5 rounded-full border border-space-red dark:border-space-yellow text-space-red dark:text-space-yellow hover:bg-space-red hover:text-white dark:hover:bg-space-yellow dark:hover:text-black transition-all duration-300 text-sm md:text-base"
            >
              Departament
            </button>
          </div>

          <!-- Acordeon integrantes -->
          <div id={`depto-${lider.id}-en`} class="grid transition-all duration-500 ease-in-out" style="grid-template-rows: 0fr; opacity: 0;">
            <div class="overflow-hidden">
              <div class="mt-6 pt-6 border-t border-black/10 dark:border-white/10">
                <ul class="text-left space-y-4 kanit-light text-base md:text-lg w-full">
                  {lider.integrantes.map((integrante) => (
                    <li class="flex items-center justify-between gap-3 w-full">
                      <div class="flex items-start gap-3">
                        <span class="w-2 h-2 mt-2.5 rounded-full bg-space-red dark:bg-space-yellow shrink-0" />
                        <span>{integrante.nombre ? integrante.nombre : integrante}</span>
                      </div>
                      {integrante.linkedin && (
                        <a href={integrante.linkedin} target="_blank" rel="noopener noreferrer" class="p-2 -my-2 text-black dark:text-white hover:text-space-red dark:hover:text-space-yellow transition-colors duration-300 shrink-0">
                          <LinkedinIcon class="w-6 h-6" />
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

        </div>
      ))
    }
  </div>
</section>

<script is:inline>
  function toggleDeptoEng(id, btn, textOpen, textClose) {
    const el = document.getElementById(id);
    const isOpen = el.style.gridTemplateRows === '1fr';
    
    if (!isOpen) {
      el.style.gridTemplateRows = '1fr';
      el.style.opacity = '1';
      btn.innerText = textClose;
    } else {
      el.style.gridTemplateRows = '0fr';
      el.style.opacity = '0';
      btn.innerText = textOpen;
    }
  }
</script>
